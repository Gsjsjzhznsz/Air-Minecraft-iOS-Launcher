+
+static void Amethyst_EmbedTask(void *vctx)
+{
+    Amethyst_EmbedCtx *ctx = (Amethyst_EmbedCtx *)vctx;
+    ctx->result = Amethyst_EmbedSDLViewIntoHostWindow(ctx->data);
+}
+
+static void Amethyst_ShowEmbeddedTask(void *userdata)
+{
+    SDL_UIKitWindowData *data = (__bridge SDL_UIKitWindowData *)userdata;
+
+    UIView *sdlView = data.viewcontroller.view;
+    UIView *container = sdlView.superview;
+    if (container) {
+        UIView *ctrlView = Amethyst_FindSubviewOfClass(container, NSClassFromString(@"ControlLayout"));
+        [sdlView removeFromSuperview];
+        if (ctrlView && ctrlView.superview == container) {
+            [container insertSubview:sdlView belowSubview:ctrlView];
+        } else {
+            [container addSubview:sdlView];
+        }
+    }
+}
