+// --- Amethyst: embed the SDL view into the host app's window hierarchy ---
+//
+// The launcher (Amethyst) draws the game area and its on-screen control
+// buttons inside its own UIWindow (GLFW-style: render layer below, buttons
+// above). If we present our own UIWindow with makeKeyAndVisible, it covers
+// the control layer. Instead, find the host window's control view
+// ("ControlLayout") and insert the SDL content view directly below it, then
+// keep our own UIWindow hidden. This places the render layer exactly where
+// GLFW-based rendering would be.
+
+static UIView *Amethyst_FindSubviewOfClass(UIView *view, Class cls)
+{
+    if ([view isKindOfClass:cls]) {
+        return view;
+    }
+    for (UIView *sub in view.subviews) {
+        UIView *found = Amethyst_FindSubviewOfClass(sub, cls);
+        if (found) {
+            return found;
+        }
+    }
+    return nil;
+}
+
+bool Amethyst_EmbedSDLViewIntoHostWindow(SDL_UIKitWindowData *data)
 {
+    @autoreleasepool {
+        UIWindow *sdlWindow = data.uiwindow;
+        UIView *sdlView = data.viewcontroller.view;
+
+        // Locate the host window: any visible window other than ours.
+        UIWindow *host = nil;
+        for (UIWindow *window in [UIApplication sharedApplication].windows) {
+            if (window != sdlWindow && !window.hidden && window.rootViewController != nil) {
+                host = window;
+                break;
+            }
+        }
+        if (!host) {
+            NSLog(@"[AmethystSDL] embed: no host window found");
+            return false;
+        }
+
+        // The control overlay marks the host game screen.
+        UIView *ctrlView = Amethyst_FindSubviewOfClass(host.rootViewController.view, NSClassFromString(@"ControlLayout"));
+        if (!ctrlView || !ctrlView.superview) {
+            NSLog(@"[AmethystSDL] embed: ControlLayout not found in host window");
+            return false;
+        }
+        UIView *container = ctrlView.superview;
+
+        // GLFW-style placement: the launcher's own render surface
+        // (GameSurfaceView) lives inside a screen-sized "touchView" that is a
+        // sibling of ControlLayout under rootView. Note rootView is 30pt
+        // WIDER than the screen (edge-gesture room), so sizing against
+        // ctrlView.superview would stretch/offset the picture. Put our view
+        // exactly where GameSurfaceView was instead.
+        UIView *gameSurface = Amethyst_FindSubviewOfClass(host.rootViewController.view, NSClassFromString(@"GameSurfaceView"));
+        if (gameSurface && gameSurface.superview) {
+            UIView *touchView = gameSurface.superview;
+
+            sdlView.frame = touchView.bounds;
+            sdlView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+            // Topmost inside touchView: covers the old surface, while
+            // ControlLayout stays above as a sibling of touchView. Touch
+            // gestures attached to touchView keep working like they did with
+            // GameSurfaceView.
+            gameSurface.hidden = YES;
+            [touchView addSubview:sdlView];
+
+            // Bring the launcher's virtual mouse cursor and other UI
+            // elements to the front so they render above the SDL layer.
+            for (UIView *sub in [touchView.subviews copy]) {
+                if (sub != sdlView && ![sub isKindOfClass:NSClassFromString(@"SDL_uikitmetalview")]) {
+                    [touchView bringSubviewToFront:sub];
+                }
+            }
+
+            // Our own UIWindow is no longer presented; the embedded view lives
+            // in the host window now.
+            sdlWindow.hidden = YES;
+            NSLog(@"[AmethystSDL] embed: view embedded into host touchView (GLFW placement)");
+            NSLog(@"[AmethystSDL][MetalDebug] sdlView window=%p frame=%@ super=%@ superWindow=%p",
+                  (__bridge void *)sdlView.window,
+                  NSStringFromCGRect(sdlView.frame),
+                  NSStringFromClass([touchView class]),
+                  (__bridge void *)touchView.window);
+            return true;
+        }
+
+        // Hide the host's own game surface so the SDL render shows through.
+        for (UIView *sub in container.subviews) {
+            if (sub != ctrlView) {
+                sub.hidden = YES;
+            }
+        }
+
+        sdlView.frame = container.bounds;
+        sdlView.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+        [container insertSubview:sdlView belowSubview:ctrlView];
+
+        // Our own UIWindow is no longer presented; the embedded view lives in
+        // the host window now.
+        sdlWindow.hidden = YES;
+        NSLog(@"[AmethystSDL] embed: view embedded into host window");
+        return true;
+    }
+}
